{
  "name": "prometheon-code",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.10.0",
  "publisher": "prometheon",
  "license": "MIT",
  "private": true,
  "icon": "media/prometheon-icon-256.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mateuus/PrometheonCode.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/Mateuus/PrometheonCode/issues"
  },
  "homepage": "https://github.com/Mateuus/PrometheonCode#readme",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "agents",
    "orchestration",
    "multi-agent",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prometheon",
          "title": "Prometheon",
          "icon": "media/prometheon-view-mono.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "prometheon-secondary",
          "title": "Prometheon",
          "icon": "media/prometheon-view-mono.svg"
        }
      ]
    },
    "views": {
      "prometheon": [
        {
          "type": "webview",
          "id": "prometheon.chatView",
          "name": "Prometheon",
          "icon": "media/prometheon-view-mono.svg"
        }
      ],
      "prometheon-secondary": [
        {
          "type": "webview",
          "id": "prometheon.chatViewSecondary",
          "name": "Prometheon",
          "icon": "media/prometheon-view-mono.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "prometheon.openChat",
        "title": "%command.openChat%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.newLocalChat",
        "title": "%command.newLocalChat%",
        "category": "Prometheon",
        "icon": "$(add)"
      },
      {
        "command": "prometheon.configureWorkspace",
        "title": "%command.configureWorkspace%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.initializeWorkspace",
        "title": "%command.initializeWorkspace%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.selectMainAgent",
        "title": "%command.selectMainAgent%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.selectWorkMode",
        "title": "%command.selectWorkMode%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.selectAutonomy",
        "title": "%command.selectAutonomy%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.disableBypassPermissions",
        "title": "%command.disableBypassPermissions%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.openConfiguration",
        "title": "%command.openConfiguration%",
        "category": "Prometheon",
        "icon": "$(account)"
      },
      {
        "command": "prometheon.addAccount",
        "title": "%command.addAccount%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.openSettings",
        "title": "%command.openSettings%",
        "category": "Prometheon",
        "icon": "$(gear)"
      },
      {
        "command": "prometheon.showDiagnostics",
        "title": "%command.showDiagnostics%",
        "category": "Prometheon"
      },
      {
        "command": "prometheon.resetLocalState",
        "title": "%command.resetLocalState%",
        "category": "Prometheon"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prometheon.newLocalChat",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "navigation@1"
        },
        {
          "command": "prometheon.openSettings",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "navigation@2"
        },
        {
          "command": "prometheon.selectWorkMode",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "1_orchestration@1"
        },
        {
          "command": "prometheon.selectAutonomy",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "1_orchestration@2"
        },
        {
          "command": "prometheon.selectMainAgent",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "1_orchestration@3"
        },
        {
          "command": "prometheon.disableBypassPermissions",
          "when": "(view == prometheon.chatView || view == prometheon.chatViewSecondary) && prometheon.bypassActive",
          "group": "1_orchestration@4"
        },
        {
          "command": "prometheon.configureWorkspace",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "2_workspace@1"
        },
        {
          "command": "prometheon.showDiagnostics",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "3_help@1"
        },
        {
          "command": "prometheon.openConfiguration",
          "when": "view == prometheon.chatView || view == prometheon.chatViewSecondary",
          "group": "1_orchestration@5"
        }
      ],
      "commandPalette": [
        {
          "command": "prometheon.disableBypassPermissions",
          "when": "prometheon.bypassActive"
        }
      ]
    },
    "configuration": {
      "title": "Prometheon",
      "properties": {
        "prometheon.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-br",
            "es"
          ],
          "enumDescriptions": [
            "%configuration.language.auto%",
            "%configuration.language.en%",
            "%configuration.language.ptbr%",
            "%configuration.language.es%"
          ],
          "default": "auto",
          "description": "%configuration.language%",
          "order": 1
        },
        "prometheon.speech.language": {
          "type": "string",
          "default": "auto",
          "description": "%configuration.speech.language%",
          "order": 2
        },
        "prometheon.speech.pythonPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.speech.pythonPath%",
          "order": 3
        },
        "prometheon.agents.globalConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 6,
          "description": "%configuration.agents.globalConcurrency%",
          "order": 4
        },
        "prometheon.hub.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.hub.url%",
          "order": 2
        },
        "prometheon.chat.defaultType": {
          "type": "string",
          "enum": [
            "local",
            "web"
          ],
          "enumDescriptions": [
            "%configuration.chat.defaultType.local%",
            "%configuration.chat.defaultType.web%"
          ],
          "default": "local",
          "description": "%configuration.chat.defaultType%",
          "order": 3
        },
        "prometheon.workspace.promptOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.workspace.promptOnOpen%",
          "order": 4
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "test": "npm run compile-tests && npm run compile && vscode-test",
    "vsix": "node -e \"require('node:fs').mkdirSync('../dist',{recursive:true})\" && vsce package --no-dependencies --out ../dist/",
    "preview": "node preview/server.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.9",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "l10n": "./l10n"
}
