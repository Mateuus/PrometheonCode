# Prometheon Hub — produção.
#
# Copie para `deploy/.env` no servidor e preencha. Este arquivo é o exemplo e
# vai para o Git; o `.env` preenchido **não vai**, nunca.
#
# Nada aqui é reaproveitado do desenvolvimento. Os segredos do `.env` da sua
# máquina já passaram por logs, backups e histórico de terminal — valem para
# quem só pode alcançar sua rede, não para o que vai ficar exposto à internet.

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Endereços públicos
# ---------------------------------------------------------------------------
#
# Estas três variáveis fazem mais do que parece.
#
# `HUB_API_URL` decide se o cookie de refresh sai com a marca `secure` e se a
# URL do WebSocket entregue ao cliente é `wss://`. Se ficar em `http://`, o
# cookie viaja sem proteção e o navegador recusa a conexão de tempo real numa
# página HTTPS.
#
# `CORS_ORIGINS` decide **onde o refresh token é entregue**. A API só o manda em
# cookie `HttpOnly` quando a origem da requisição está nesta lista. Um valor
# errado não quebra o login: ele passa a devolver o refresh no corpo da resposta,
# ao alcance de qualquer script na página, e nada no comportamento denuncia isso.

# Em qual endereço a API e o web escutam no host.
#
# `127.0.0.1` quando o reverse proxy roda na mesma máquina. Quando ele está
# noutro servidor, precisa ser o IP deste na rede — o loopback daqui é invisível
# de fora. Nunca `0.0.0.0`: publicaria em interfaces que você não pretendia.
#
# Escutar na rede exige a regra de firewall que restringe estas portas ao IP do
# proxy. Sem ela, qualquer máquina da LAN fala direto com a API e, como ela
# confia no `X-Forwarded-For`, forja o IP de origem e contorna o rate limit.
BIND_ADDRESS=127.0.0.1

HUB_API_PORT=3551
HUB_WEB_PORT=3550
HUB_API_URL=https://api.prometheoncode.xyz
HUB_WEB_URL=https://hub.prometheoncode.xyz
CORS_ORIGINS=https://hub.prometheoncode.xyz

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
#
# `DATABASE_HOST` é sobrescrito pelo compose para `mysql`, o nome do serviço na
# rede interna. Deixe como está.

DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=prometheon
DATABASE_PASSWORD=
DATABASE_NAME=prometheon

# Só o container do MySQL usa. Não é a senha da aplicação.
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

VALKEY_ENABLED=true
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_KEY_PREFIX=prometheon:

# ---------------------------------------------------------------------------
# Segredos
# ---------------------------------------------------------------------------
#
# Quatro valores distintos, nunca o mesmo repetido: cada um assina uma coisa
# diferente, e reaproveitar faria um token de tempo real valer como token de
# acesso. Gere cada um com:
#
#   openssl rand -base64 48
#
# `SECRETS_MASTER_KEY` cifra as credenciais de integração guardadas no banco.
# Perdê-la significa perder o acesso a tudo que foi cifrado com ela — ela entra
# no backup, e o backup não fica no mesmo servidor.

AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_REALTIME_TOKEN_SECRET=
SECRETS_MASTER_KEY=

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
#
# `smtp` é o transporte de verdade. Em desenvolvimento o valor é `capture`, que
# grava a mensagem em disco — se isso vazar para produção, ninguém recebe o
# e-mail de verificação e nenhum cadastro se conclui, sem erro nenhum aparecer.
#
# Host e porta são sobrescritos pelo compose para o container `mailserver`.

MAIL_TRANSPORT=smtp
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@prometheoncode.xyz
SMTP_PASSWORD=
MAIL_FROM=Prometheon <noreply@prometheoncode.xyz>
MAIL_HOSTNAME=smtp.prometheoncode.xyz

# ---------------------------------------------------------------------------
# Login com GitHub
# ---------------------------------------------------------------------------
#
# **Um OAuth App novo, só para produção.** O de desenvolvimento aponta para
# `localhost` e o secret dele já circulou. Crie em Settings → Developer settings
# → OAuth Apps, com esta callback exata — o GitHub compara a string inteira, e
# uma barra a mais recusa a autorização.
#
# Os escopos são só de identidade. Não acrescente `repo`: ler repositório é
# outro consentimento, e pedi-lo na tela de entrada faz o cadastro exigir acesso
# ao código só para dizer um nome.

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.prometheoncode.xyz/v1/auth/oauth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email

# ---------------------------------------------------------------------------
# Armazenamento de objetos
# ---------------------------------------------------------------------------
#
# O token precisa de escopo **apenas no bucket do Prometheon**. Uma chave com
# alcance na conta inteira transforma qualquer falha aqui em acesso aos seus
# outros buckets.

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=prometheon
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_CDN_DOMAIN=cdn.prometheoncode.xyz

# ---------------------------------------------------------------------------
# Operação
# ---------------------------------------------------------------------------
#
# Rate limit desligado só se justifica em teste automatizado. Em produção, é o
# que separa uma tentativa de descobrir senha por força bruta de um dia ruim.

RATE_LIMIT_ENABLED=true
SERVICE_VERSION=
GIT_COMMIT_SHA=
