# Servidor de e-mail do domínio.
#
# Faz duas coisas diferentes, e é bom não confundi-las:
#
# 1. **Envio da aplicação** — verificação de cadastro, recuperação de senha e
#    convite, mandados pela conta `noreply@`. Ninguém lê essa caixa.
# 2. **Caixas de pessoas** — `mateus@prometheoncode.xyz` e afins, que são
#    abertas num cliente de e-mail e respondidas.
#
# É o segundo uso que exige IMAP: sem ele a mensagem chega, fica gravada dentro
# do container e não há como abrir.

# --- Protocolos -------------------------------------------------------------

# IMAP é como o cliente de e-mail lê a caixa. Porta 993, sempre com TLS.
ENABLE_IMAP=1

# POP3 fica desligado: ele baixa e apaga do servidor, então a mensagem lida no
# computador some do celular. Para caixa usada em mais de um aparelho — que é
# o caso de todo mundo hoje — o IMAP é o que funciona.
ENABLE_POP3=0

# --- Segurança de entrega ---------------------------------------------------

# TLS com o certificado que o aaPanel renova, montado como volume.
SSL_TYPE=letsencrypt

# Só quem autentica envia. Sem isto o servidor vira relay aberto e, em questão
# de horas, um repetidor de spam — o que queima o IP e o domínio junto.
PERMIT_DOCKER=connected-networks
SPOOF_PROTECTION=1

# Assina cada mensagem com DKIM. Sem assinatura, Gmail e Outlook tratam o
# remetente como não verificado e mandam direto para spam.
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1

# --- Antispam e antivírus ---------------------------------------------------

# Agora que há caixa de pessoa recebendo mensagem da internet, o filtro deixa de
# ser opcional: um endereço publicado começa a receber spam em dias.
ENABLE_SPAMASSASSIN=1
MOVE_SPAM_TO_JUNK=1

# ClamAV desligado por consumo: sozinho pede mais de 1 GB de memória, e o ganho
# num servidor onde ninguém abre anexo de estranho é pequeno. Ligue se as caixas
# passarem a receber arquivo de fora.
ENABLE_CLAMAV=0

# Bane o IP depois de tentativas seguidas de adivinhar senha. Um servidor de
# e-mail exposto começa a receber essas tentativas na primeira semana.
ENABLE_FAIL2BAN=1

# --- Relay de saída ---------------------------------------------------------
#
# Preencha se a entrega direta não estiver funcionando — o caso comum em IP
# residencial, onde a porta 25 de saída costuma ser bloqueada pelo provedor e o
# reverso do IP não aponta para o seu domínio. Com estas quatro linhas, o
# servidor continua sendo seu e a entrega sai por um remetente com reputação.
#
# RELAY_HOST=
# RELAY_PORT=587
# RELAY_USER=
# RELAY_PASSWORD=

# --- Diagnóstico ------------------------------------------------------------

LOG_LEVEL=info
POSTMASTER_ADDRESS=postmaster@prometheoncode.xyz
