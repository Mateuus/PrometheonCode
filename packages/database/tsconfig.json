{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Explícito porque o TypeScript não descobre `@types/node` sozinho através
    // dos links que o pnpm cria em `node_modules/@types`.
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ]
}
