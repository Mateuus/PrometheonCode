# Copie para .env e preencha. O .env nunca é versionado.

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Portas do desenvolvimento local
HUB_API_PORT=3551
HUB_WEB_PORT=3550
HUB_API_URL=http://127.0.0.1:3551
HUB_WEB_URL=http://127.0.0.1:3550

# Origens autorizadas no CORS, separadas por vírgula
CORS_ORIGINS=http://127.0.0.1:3550,http://localhost:3550

# ---------------------------------------------------------------------------
# Banco de dados (MySQL)
# ---------------------------------------------------------------------------
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# ---------------------------------------------------------------------------
# Redis / Valkey (presença, filas, rate limit, cache)
# ---------------------------------------------------------------------------
VALKEY_ENABLED=true
VALKEY_URL=
VALKEY_HOST=
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_KEY_PREFIX=prometheon:

# ---------------------------------------------------------------------------
# Segredos da aplicação
#
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Trocar qualquer um destes invalida as sessões emitidas com o valor anterior.
# ---------------------------------------------------------------------------
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_REALTIME_TOKEN_SECRET=
# Chave mestre do envelope encryption dos tokens de integração Git
SECRETS_MASTER_KEY=

# ---------------------------------------------------------------------------
# E-mail
#
# Em desenvolvimento aponta para o Maildev do compose, que não entrega nada
# para fora — nenhuma mensagem de teste chega a um endereço real.
# ---------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Prometheon <no-reply@prometheoncode.xyz>"

# `smtp` entrega de verdade; `capture` grava em disco e loga o link — use este
# quando não houver servidor SMTP no ar, senão o cadastro não conclui.
MAIL_TRANSPORT=capture
# Vazio usa o temporário do sistema. Nunca aponte para dentro do repositório:
# as mensagens contêm links com token.
MAIL_CAPTURE_DIR=

# ---------------------------------------------------------------------------
# Operação
# ---------------------------------------------------------------------------
# Desligue apenas em teste automatizado.
RATE_LIMIT_ENABLED=true
SERVICE_VERSION=
GIT_COMMIT_SHA=
BUILD_TIMESTAMP=

# ---------------------------------------------------------------------------
# Worker (apps/hub-worker)
#
# Todas têm padrão embutido — a lista existe para documentar o que dá para
# ajustar em produção sem ler o código.
# ---------------------------------------------------------------------------

# Concorrência geral e por fila (WORKER_CONCURRENCY_WEBHOOKS, _RETENTION, …)
WORKER_CONCURRENCY=4

# Publicador do Transactional Outbox
WORKER_OUTBOX_ENABLED=true
WORKER_OUTBOX_BATCH_SIZE=50
WORKER_OUTBOX_POLL_INTERVAL_MS=250
WORKER_OUTBOX_IDLE_INTERVAL_MS=1000
# TTL do lock por mensagem. Curto demais publica duas vezes; longo demais
# atrasa a retomada quando um worker morre segurando o lock.
WORKER_OUTBOX_LOCK_TTL_MS=15000
WORKER_OUTBOX_MAX_ATTEMPTS=8
WORKER_OUTBOX_BACKOFF_BASE_MS=500
WORKER_OUTBOX_BACKOFF_MAX_MS=60000
WORKER_OUTBOX_LAG_INTERVAL_MS=15000

WORKER_QUEUES_ENABLED=true
WORKER_HEALTH_ENABLED=true
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3552
WORKER_HEALTH_FILE=
WORKER_EXPORT_DIR=
WORKER_EXPORT_TTL_MS=604800000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_INSTANCE_ID=
