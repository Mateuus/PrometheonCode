{
  "name": "@prometheon/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "prometheon": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@prometheon/agent-runtime": "workspace:*",
    "ink": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
